PORT=4000
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/optics_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# AWS SES / SMTP Mail Configuration
SMTP_HOST="75y3xsuwutwh.hkph.mail-manager-smtp.amazonaws.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_SECURE=false
SMTP_FROM='"Optics" <no-reply@ivors.in>'

# Frontend Client URL
CLIENT_URL="http://localhost:3000"

# Storage Configuration ('local' or 's3')
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage_uploads"
